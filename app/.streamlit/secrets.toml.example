# Secretos locales (copiar a `.streamlit/secrets.toml`; ese archivo NO se versiona).
# También se puede usar la variable de entorno equivalente indicada en cada caso.

# camino de inferencia: "local" (joblib) o "api" (Render). Por defecto: local.
modo_inferencia = "local"

# Solo si modo_inferencia = "api".  (env: OLIST_API_URL)
# api_url = "https://TU-API.onrender.com"
# api_timeout_segundos = 60          # (env: OLIST_API_TIMEOUT)

# Rutas opcionales si los artefactos viven en otro sitio.  (env: OLIST_MODELO_PATH, ...)
# modelo_path = "../model/modelo_riesgo.joblib"
# ficha_path = "ficha_modelo.md"
# datos_ejemplo_path = "datos/ejemplo_pedidos.csv"

# Operación
# capacidad_contacto = 0.10          # (env: OLIST_CAPACIDAD_CONTACTO)
# umbral_riesgo_alto = 0.45          # (env: OLIST_UMBRAL_ALTO)
# umbral_riesgo_medio = 0.20         # (env: OLIST_UMBRAL_MEDIO)
